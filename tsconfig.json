{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // Free today (verified: zero errors each). They are cheap to keep and each
    // one has caught a real class of bug elsewhere.
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    // NOT enabled, with the cost measured on 2026-07-31 so the decision can be
    // revisited rather than rediscovered:
    //   noUncheckedIndexedAccess        → 416 errors
    //   noPropertyAccessFromIndexSignature → 452 errors
    //   exactOptionalPropertyTypes      → 247 errors
    //   noUnusedParameters              →   1 error (the `_`-prefix convention
    //                                       is handled by eslint instead)
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `relay` and `runner` are standalone packages with
  // their own package.json, tsconfig and node_modules. Typechecking them from
  // here resolves their imports against the WEB app's dependency tree, where
  // `@juno/agent-core` does not exist — errors that say nothing about either
  // project, only that the wrong compiler was pointed at one. Each subproject
  // typechecks itself in its own workflow.
  // bench/workflows/results holds recorded benchmark runs, including code that
  // other products delivered: evidence to validate, not source to typecheck.
  "exclude": ["node_modules", "relay", "runner", "bench/workflows/results"]
}
