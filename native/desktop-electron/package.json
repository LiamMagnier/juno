{
  "name": "@juno/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Juno Desktop — macOS AI workspace (Chat · Work · Code)",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build --force tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tokens": "tsx scripts/generate-tokens.ts",
    "tokens:check": "tsx scripts/generate-tokens.ts --check",
    "contract:check": "tsx scripts/check-agent-contract.ts",
    "gates": "npm run typecheck && npm run lint && npm run tokens:check && npm run contract:check && npm run test",
    "package:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@juno/agent-core": "file:../../runner/agent-core",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^12.43.0",
    "globals": "^17.11.0",
    "postcss": "^8.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "_allowScriptsNote": "electron's postinstall downloads the Electron binary; node-pty's fetches its prebuilt native module; esbuild's installs its platform binary. Without these three the app cannot launch and the terminal cannot load. They are reviewed, first-party install scripts for dependencies this app cannot run without.",
  "allowScripts": {
    "electron": true,
    "node-pty": true,
    "esbuild": true
  }
}
