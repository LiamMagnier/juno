  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "comment": "A count of the user's favorite models.",
      "isCommentAutoGenerated": true
    },
    "A project changed on another device.": {
      "comment": "A description of a conflict between a local and server version of a project.",
      "isCommentAutoGenerated": true
    },
    "Add to project": {
      "comment": "A heading for the list of projects to which a conversation can be added.",
      "isCommentAutoGenerated": true
    },
    "All versions of this artifact will be removed.": {},
    "Artifacts generated in conversations appear here.": {
      "comment": "A description of the content that appears in the \"Artifacts\" section of the Juno mobile app.",
      "isCommentAutoGenerated": true
    },
    "Conversations are kept and unlinked; project files are removed.": {
      "comment": "A description of the action of deleting a project.",
      "isCommentAutoGenerated": true
    },
    "Create a project to group conversations and files.": {
      "comment": "A description of the action to create a new project.",
      "isCommentAutoGenerated": true
    },
    "Custom instructions": {
      "comment": "A heading displayed above the user's custom instructions",
      "isCommentAutoGenerated": true
    },
    "Dark": {},
    "Erasing memory…": {
      "comment": "The title of a button that erases all saved facts and the summary.",
      "isCommentAutoGenerated": true
    },
    "Everything synced to this device is searchable offline.": {
      "comment": "A description of the search feature.",
      "isCommentAutoGenerated": true
    },
    "Favorite models": {
      "comment": "A heading displayed above a list of favorite Juno Mobile models.",
      "isCommentAutoGenerated": true
    },
    "Files uploaded to Juno will appear here offline.": {
      "comment": "A description of the content that will be displayed when a user has no files.",
      "isCommentAutoGenerated": true
    },
    "Included in every conversation linked to this project.": {
      "comment": "(",
      "isCommentAutoGenerated": true
    },
    "Instant": {
      "comment": "A label for a button that disables reasoning.",
      "isCommentAutoGenerated": true
    },
    "Instructions": {},
    "Juno": {
      "comment": "The name of the app.",
      "isCommentAutoGenerated": true
    },
    "Juno remembers helpful details from your chats so it can give you better, more personalized answers.": {
      "comment": "A description of how Juno remembers user input.",
      "isCommentAutoGenerated": true
    },
    "Juno will no longer use this fact in conversations.": {
      "comment": "A confirmation alert that warns the user that erasing a memory will remove it from the app.",
      "isCommentAutoGenerated": true
    },
    "Light": {},
    "Linked conversations are kept. Project files are removed.": {
      "comment": "(",
      "isCommentAutoGenerated": true
    },
    "Manage edits": {
      "comment": "A heading for the list of memories.",
      "isCommentAutoGenerated": true
    },
    "Memory or settings changed on another device.": {},
    "Memory summary": {
      "comment": "The title of a section that shows a user's memory summary.",
      "isCommentAutoGenerated": true
    },
    "No linked conversations": {},
    "No project files": {
      "comment": "(",
      "isCommentAutoGenerated": true
    },
    "No saved memories yet. Facts Juno learns in chats appear here.": {
      "comment": "A description of the empty state when a user has no saved memories.",
      "isCommentAutoGenerated": true
    },
    "No summary yet — Juno builds this from what it learns in chats.": {
      "comment": "A description of the user's memory if it's empty.",
      "isCommentAutoGenerated": true
    },
    "Nothing matches “%@”.": {
      "comment": "A description of the search results when there are no results for the current search query. The argument is the search query.",
      "isCommentAutoGenerated": true
    },
    "Preview": {
      "comment": "A label for a button that displays the artifact's rendered preview.",
      "isCommentAutoGenerated": true
    },
    "Project instructions are included in every linked conversation.": {
      "comment": "A description of the project instructions.",
      "isCommentAutoGenerated": true
    },
    "Reasoning": {
      "comment": "A label for the reasoning section of a chat message.",
      "isCommentAutoGenerated": true
    },
    "Reconnect to hydrate the latest artifact content.": {},
    "Resetting permanently removes every saved fact and the summary, and old chats are not re-learned.": {
      "comment": "A description of the action of erasing all memory.",
      "isCommentAutoGenerated": true
    },
    "Source": {},
    "Sources": {
      "comment": "A heading for the sources of a message.",
      "isCommentAutoGenerated": true
    },
    "System": {},
    "Thinking about your request": {
      "comment": "A description of the \"Thinking about your request\" status.",
      "isCommentAutoGenerated": true
    },
    "This conversation is ready for its first message.": {
      "comment": "A description of the empty state of a Juno Mobile conversation.",
      "isCommentAutoGenerated": true
    },
    "This permanently removes every saved fact and the consolidated summary. This cannot be undone.": {
      "comment": "A confirmation alert for erasing all memory.",
      "isCommentAutoGenerated": true
    },
    "Updated %@": {
      "comment": "A timestamp showing when the memory summary was last updated. The argument is a date and time.",
      "isCommentAutoGenerated": true
    },
    "While paused, Juno won't save new details from your chats. Existing memories are kept.": {
      "comment": "A description of the memory settings.",
      "isCommentAutoGenerated": true
    },
    "^[%@ conversation](inflect: true) · ^[%@ file](inflect: true) · %@": {
      "comment": "A line of text that provides information about a project, including the number of conversations, files, and the last time the project was updated. The first argument is the number of conversations. The second argument is the number of files. The third argument is the formatted relative time since the project was last updated.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "^[%1$@ conversation](inflect: true) · ^[%2$@ file](inflect: true) · %3$@"
          }
        }
      }
    },
    "^[%@ memory](inflect: true)": {
      "comment": "A count of the number of memories.",
      "isCommentAutoGenerated": true
    },
