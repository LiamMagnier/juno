<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.liammagnier.JunoMobile.code-refresh</string>
		<string>com.liammagnier.JunoMobile.research-refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(JUNO_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(JUNO_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(JUNO_AUTH_CALLBACK_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>JunoChannel</key>
	<string>$(JUNO_CHANNEL)</string>
	<key>JunoContractVersion</key>
	<string>$(JUNO_CONTRACT_VERSION)</string>
	<key>JunoGitSHA</key>
	<string>$(JUNO_GIT_SHA)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Juno uses the camera to take a photo for a message, and to show Juno what you are looking at during a voice conversation. Screen sharing in voice uses only what is on this screen.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Juno uses the microphone for voice conversations and to dictate a message instead of typing it. Audio is only captured while a call or dictation is running.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Juno saves images you generate to your photo library when you ask it to.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Juno shows your most recent photos so you can attach one without leaving the chat.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Juno turns what you say into text so you can dictate a message. Recognition runs on this device whenever the language supports it.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Newsreader24pt-Regular.ttf</string>
		<string>Newsreader24pt-Medium.ttf</string>
		<string>Newsreader-Italic-Variable.ttf</string>
		<string>Newsreader24pt-SemiBold.ttf</string>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>square.and.pencil</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>New chat</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.liammagnier.JunoMobile.new-chat</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>waveform</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Voice</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.liammagnier.JunoMobile.voice</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>chevron.left.forwardslash.chevron.right</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Juno Code</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.liammagnier.JunoMobile.code</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
