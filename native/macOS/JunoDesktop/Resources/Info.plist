<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>$(JUNO_DISPLAY_NAME)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(JUNO_DISPLAY_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>$(PRODUCT_BUNDLE_IDENTIFIER).auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>$(JUNO_AUTH_CALLBACK_SCHEME)</string>
            </array>
        </dict>
    </array>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Liam Magnier.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Juno uses the microphone when you choose to dictate or start a voice conversation.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Juno turns speech into draft text when you choose dictation.</string>
    <!--
      Juno Code opens whole repositories the user points it at, and those
      normally live in one of these three folders. Without a usage string macOS
      shows an unexplained consent prompt, which is the worst possible moment to
      say nothing about why a coding agent wants the folder.
    -->
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Juno Code needs access to open repositories you keep in Documents, read their files and run their tests.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Juno Code needs access to open repositories you keep on the Desktop, read their files and run their tests.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Juno Code needs access to open repositories you keep in Downloads, read their files and run their tests.</string>
    <!--
      `osascript` is a critical-risk command the agent may run only behind an
      explicit approval; sending the event still needs this declaration.
    -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Juno Code asks before running any command that controls another app, such as opening a Simulator or a built app.</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>ATSApplicationFontsPath</key>
    <string>.</string>
</dict>
</plist>

