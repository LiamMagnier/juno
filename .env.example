# Juno — environment configuration
#
# Copy to `.env` and fill in the REQUIRED block. Everything else is optional and
# the related feature degrades gracefully when absent — see docs/JUNO.md §19.
#
# Precedence: Next.js gives `.env.local` priority over `.env`. `.env.local` is
# for local overrides only and must never hold production values.
#
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
#
# DATABASE_URL serves runtime queries; DIRECT_URL serves schema operations
# (migrate deploy / db push / db execute — see `directUrl` in
# prisma/schema.prisma). Migrations need a connection of their own: over a
# pooled one the _prisma_migrations completion write has twice gone missing,
# leaving "failed" rows that P3009-poison every later deploy. The deploy
# workflow HARD-FAILS when DIRECT_URL is missing.
#
# On Supabase, set BOTH to the Supavisor **session** pooler (port 5432), which
# you'll find under Connect → Session pooler:
#
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# Two traps that make the other strings the wrong answer here:
#   - the *transaction* pooler (port 6543) multiplexes connections and cannot
#     keep prepared statements, which Prisma needs;
#   - the *direct* host (db.<ref>.supabase.co) resolves to IPv6 only, and the
#     deploy VM has no global IPv6 address, so it is simply unreachable there.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT signing seed. `openssl rand -base64 32`. Rotating this signs every user
# out AND must match the voice relay's own AUTH_SECRET.
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Default chat provider, and the utility model behind auto-titling, memory
# extraction, the moderation classifier, clarify triage and UI translation.
# Without a FUNDED key here, the product's default path fails.
ANTHROPIC_API_KEY=""

# Public origin. Baked into the client bundle at BUILD time; also used for reset
# links, OAuth callbacks, the native token issuer, and Apple MCP dial-in.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public origin for Auth.js redirects behind nginx. Without it, sign-out sends
# the user to localhost in production.
AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# ENCRYPTION AT REST
# ─────────────────────────────────────────────────────────────────────────────
# Message content/reasoning and every connector + OAuth token are AES-256-GCM
# encrypted.
#
# PRODUCTION REFUSES TO START without one of DATA_ENCRYPTION_KEYRING or
# DATA_ENCRYPTION_KEY. In development, a key is derived from AUTH_SECRET so a
# fresh checkout runs — but that couples two unrelated secrets, and rotating
# AUTH_SECRET after a leak would permanently orphan every stored message.
#
# LOSING THESE VALUES MAKES EVERY STORED MESSAGE UNREADABLE — back them up
# separately from the database.
#
# Single key (openssl rand -base64 32). Stored payloads name it `legacy`.
DATA_ENCRYPTION_KEY=""
# Rotation: every key that must still DECRYPT, as `<keyId>:<base64Key>` pairs,
# plus the id that ENCRYPTS new rows. Both the outgoing and incoming keys must
# stay listed until `npm run crypto:rotate:messages` has rewritten every row —
# it is online, resumable (--resume) and idempotent, so it can be stopped and
# restarted, and a half-finished rotation is still a readable database.
#   DATA_ENCRYPTION_KEYRING="2026a:<base64>,2026b:<base64>"
#   DATA_ENCRYPTION_ACTIVE_KEY_ID="2026b"
DATA_ENCRYPTION_KEYRING=""
DATA_ENCRYPTION_ACTIVE_KEY_ID=""
# Rotation: list every key that must still decrypt (comma-separated) and name
# the one to encrypt with. `npm run crypto:rotate` re-encrypts in place.
TOKEN_ENCRYPTION_KEYS=""
TOKEN_ENCRYPTION_PRIMARY=""

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated. These accounts get the OWNER plan (unlimited, no rate limits,
# no budget ceiling) and the /admin surface. Resolved from the env per request —
# there is no admin column in the database.
OWNER_EMAILS=""

# ─────────────────────────────────────────────────────────────────────────────
# BILLING (Stripe)
# ─────────────────────────────────────────────────────────────────────────────
# Create three recurring monthly PRODUCTS and copy each PRICE id (price_…).
# A tier whose price id is unset still renders on /upgrade and then 503s at
# checkout, so set all three or remove the tier from PLAN_LIST.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_MAX=""
STRIPE_PRICE_MAX20=""

# Annual prices — the SAME plans billed yearly, at twelve times the monthly
# price. Juno deliberately offers no annual discount; what the interval buys is
# one invoice a year instead of twelve. Leave these empty and the monthly/yearly
# toggle simply does not render.
#
# The entitlement and the MONTHLY budget are identical on both intervals: a
# yearly Stripe period still yields month-sized budget windows on the
# subscriber's anniversary (see billingPeriodFor).
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_MAX_YEARLY=""
STRIPE_PRICE_MAX20_YEARLY=""
STRIPE_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# BILLING (App Store / StoreKit 2)
# ─────────────────────────────────────────────────────────────────────────────
# App Store billing remains unavailable until every value below is set. This is
# intentional: Juno verifies Apple-signed JWS transactions and notifications on
# the server; it never trusts a receipt merely because a device sent one.
#
# Download Apple's current root CAs, convert each to DER, base64 encode it, then
# join the resulting values with commas. Keep the roots current per Apple's App
# Store Server Library documentation.
APP_STORE_BUNDLE_ID="com.liammagnier.JunoMobile"
APP_STORE_APPLE_ID=""
APP_STORE_ENVIRONMENT="Production"
APP_STORE_ROOT_CERTIFICATES=""
APP_STORE_ENABLE_ONLINE_CHECKS="true"
# How many EUR one USD of model spend costs (e.g. 0.92). Defaults to 1.0, which
# makes every plan budget in src/lib/spend.ts ~8% more generous than intended.
API_COST_EUR_PER_USD=""

# Ceiling on what the WHOLE deployment may spend on model calls in one UTC day,
# in USD. Per-user budgets (src/lib/spend.ts) do not bound the aggregate bill:
# signup allows up to ~4,800 accounts/day and OWNER accounts have no budget at
# all. Crossing this does not fail requests — it routes new generations to the
# cheapest capable model and alerts. Empty = no ceiling, which is the current
# behaviour and means nothing limits the total bill. Set it.
PLATFORM_DAILY_BUDGET_USD=""

# ─────────────────────────────────────────────────────────────────────────────
# CREDENTIAL RECOVERY (required for "Forgot your password?")
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Juno <hello@your-verified-domain.example>"

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE SIGN-IN (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Google Cloud Console → Credentials → OAuth client ID → Web application,
# redirect URI https://<app>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# MODEL PROVIDERS (each is hidden from the picker until its key is set)
# ─────────────────────────────────────────────────────────────────────────────
# NOTE: presence of a key is the ONLY check — an expired or unfunded key still
# lists its models in the picker and fails at send time.
OPENAI_API_KEY=""          # GPT models, realtime voice relay, default STT/TTS
GOOGLE_API_KEY=""          # Gemini (classic AI Studio key, AIza…)
ZHIPU_API_KEY=""
MOONSHOT_API_KEY=""
DEEPSEEK_API_KEY=""
MISTRAL_API_KEY=""
XAI_API_KEY=""
MINIMAX_API_KEY=""
MIMO_API_KEY=""
DASHSCOPE_API_KEY=""       # Alibaba / Qwen
SEEDANCE_API_KEY=""        # ByteDance, video only
LONGCAT_API_KEY=""
META_API_KEY=""            # Meta Model API (api.meta.ai) — Muse Spark
# The old LLAMA_API_KEY still works as an alias, but it names Meta's Llama API,
# which shut down 2026-07-06; the Muse models are on a different service with a
# different credential, so new setups should use META_API_KEY.
#
# Optional per-provider base-URL overrides (defaults in src/lib/providers.ts):
# OPENAI_BASE_URL= GOOGLE_BASE_URL= ZHIPU_BASE_URL= MOONSHOT_BASE_URL=
# DEEPSEEK_BASE_URL= MISTRAL_BASE_URL= XAI_BASE_URL= MINIMAX_BASE_URL=
# MIMO_BASE_URL= QWEN_BASE_URL= SEEDANCE_BASE_URL= LONGCAT_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# WEB SEARCH & DEEP RESEARCH
# ─────────────────────────────────────────────────────────────────────────────
# Deep research runs EVERY configured engine concurrently and merges the results
# by reciprocal-rank fusion (src/lib/search/search-engine.ts). It is not a
# fallback chain: each key you add widens the union of pages a run can reach and
# improves the ranking, because a page several engines agree on outranks one only
# the cheapest engine found.
#
# With NO key set at all, research still runs — SearXNG, DuckDuckGo and Wikipedia
# need none — but it is scraping public endpoints that rate-limit aggressively,
# and Wikipedia's index returns five results. That is the practical ceiling
# people hit as "deep research only found a handful of sites". If you want the
# breadth ChatGPT/Gemini/Perplexity reach, ONE of the four below is the single
# highest-value line in this file.
TAVILY_API_KEY=""              # AI-search native, returns page bodies with results
SERPER_API_KEY=""              # Google results
BRAVE_SEARCH_API_KEY=""        # Brave's own index (BRAVE_API_KEY also accepted)
EXA_API_KEY=""                 # neural/semantic search, returns full text

# NO API KEY AT ALL? Run your own SearXNG and point Juno at it. SearXNG is a
# metasearch aggregator: it queries Google, Bing, Brave and DuckDuckGo on your
# behalf, costs nothing, and YOU own the rate limit. This is what makes the
# keyless path actually work — the three public instances Juno falls back to
# rate-limit anonymous JSON traffic hard, and most disable the JSON API outright.
#
#   docker run -d -p 8080:8080 -v ./searxng:/etc/searxng searxng/searxng
#   # then in searxng/settings.yml:  search: { formats: [html, json] }
#
# Anthropic uses a commercial API (Brave) for Claude's web search; Google owns
# the index; OpenAI and Perplexity built their own crawlers. A self-hosted
# SearXNG is the realistic fourth option, and it needs no key.
SEARXNG_URL=""                 # e.g. http://localhost:8080

# Per-run ceiling for research started from a chat turn, in USD. A run that
# reaches it stops at `partially_completed` with its sources intact and the turn
# still answers from what it gathered. Default 2.00; the code clamps to 25.
RESEARCH_CHAT_BUDGET_USD=""

# ─────────────────────────────────────────────────────────────────────────────
# VOICE — read-aloud & dictation
# ─────────────────────────────────────────────────────────────────────────────
# WITHOUT these, Juno silently falls back to the browser's Web Speech API — the
# macOS system voice, which reads French with an English accent and
# mis-transcribes non-English dictation.
STT_PROVIDER="openai"          # "openai" | "deepgram"
TTS_PROVIDER="openai"          # "openai" | "elevenlabs"
# Optional overrides (defaults shown):
# STT_MODEL="gpt-4o-transcribe"   # far better than whisper-1 on French
# TTS_MODEL="gpt-4o-mini-tts"     # reads each language with a native accent
# TTS_VOICE="alloy"
DEEPGRAM_API_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# VOICE — realtime speech-to-speech relay (relay/)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_VOICE_RELAY_URL is a BUILD-TIME gate: the voice button does not
# exist in a bundle built without it. Changing it requires a rebuild.
NEXT_PUBLIC_VOICE_RELAY_URL=""     # ws://localhost:8787 in dev
VOICE_RELAY_URL=""                 # server-side URL used for the /healthz probe
GEMINI_LIVE_API_KEY=""             # Gemini Live needs a CLASSIC AI Studio key
ALLOWED_ORIGINS=""                 # relay CORS allowlist, comma-separated
# RELAY_ENABLE_MOCK=1              # keyless local testing
# RELAY_OPENAI_MODEL= RELAY_GEMINI_MODEL= RELAY_QWEN_MODEL=
# RELAY_QWEN_REALTIME_URL= RELAY_MINIMAX_MODEL= RELAY_MINIMAX_TTS_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE (S3-compatible: AWS S3, Cloudflare R2, Supabase Storage, MinIO)
# ─────────────────────────────────────────────────────────────────────────────
# Without a bucket, uploads fall back to a local ./.uploads directory — fine for
# dev, ephemeral on Vercel.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# Deprecated for private uploads. Juno serves attachment objects through its
# authenticated owner-aware file route even when a CDN origin is configured.
S3_PUBLIC_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# CONNECTORS (each stays hidden until its credentials are set)
# ─────────────────────────────────────────────────────────────────────────────
# Managed catalog (Gmail, Slack, Linear, …). Free key: platform.composio.dev
COMPOSIO_API_KEY=""
# COMPOSIO_BASE_URL=

# GitHub OAuth App — callback https://<app>/api/connectors/github/callback.
# The same connector's `repo` token is what cloud Code uses to clone and open PRs.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
# GITHUB_MCP_URL=

# Figma app — callback https://<app>/api/connectors/figma/callback
FIGMA_OAUTH_CLIENT_ID=""
FIGMA_OAUTH_CLIENT_SECRET=""
FIGMA_OAUTH_SCOPE=""
FIGMA_MCP_URL=""

# Notion needs nothing pre-registered (OAuth 2.1 + PKCE + Dynamic Client
# Registration); just make sure NEXT_PUBLIC_APP_URL is correct.
# NOTION_MCP_URL=

# Apple Music — Apple Developer → Keys → enable MusicKit, download the .p8
APPLE_MUSIC_TEAM_ID=""
APPLE_MUSIC_KEY_ID=""
APPLE_MUSIC_PRIVATE_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# CLOUD CODE (agent runs in GitHub Actions)
# ─────────────────────────────────────────────────────────────────────────────
# HMAC seed for the short-lived `cct_` task tokens. Never reaches the runner.
CLOUD_CODE_SECRET=""
# PAT with `actions:write` on CLOUD_CODE_REPO, used to workflow_dispatch the run.
GITHUB_DISPATCH_TOKEN=""
CLOUD_CODE_REPO=""             # e.g. LiamMagnier/juno

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT SHAPE
# ─────────────────────────────────────────────────────────────────────────────
# Share the session cookie across subdomains (UI on Vercel + API on a VM).
# COOKIE_DOMAIN=".yourdomain.com"
# Rewrite /api/* to a VM backend so long reasoning streams bypass serverless
# request timeouts.
# RENDER_BACKEND_URL="https://api.yourdomain.com"

# ─────────────────────────────────────────────────────────────────────────────
# MAINTENANCE
# ─────────────────────────────────────────────────────────────────────────────
# Free Artificial Analysis key → benchmark-grounded model grades in the nightly
# sync. Without it, grades stay hand-tuned.
AA_API_KEY=""
# Retention window for the sync change log, in days (default 30, minimum 7).
# SYNC_RETENTION_DAYS="30"
