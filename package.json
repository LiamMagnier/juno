    "shell:contract:test": "tsx --test tests/shell-contract.test.ts",
    "test:clarify": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-clarify.ts",
    "test:skill-package": "NODE_OPTIONS=--conditions=react-server tsx tests/integration/skill-package.ts",
    "test:custom-mcp": "NODE_OPTIONS=--conditions=react-server tsx tests/integration/custom-mcp.ts",
    "test:moderation": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-moderation.ts",
    "crypto:rotate": "NODE_OPTIONS=--conditions=react-server tsx scripts/rotate-encryption-keys.ts",
    "crypto:rotate:messages": "NODE_OPTIONS=--conditions=react-server tsx scripts/rotate-message-keys.ts",
    "crypto:encrypt-columns": "NODE_OPTIONS=--conditions=react-server tsx scripts/encrypt-columns.ts",
    "tasks:sweep": "tsx scripts/sweep-stuck-code-tasks.ts",
    "artifacts:maintenance": "NODE_OPTIONS=--conditions=react-server tsx scripts/artifact-maintenance.ts",
    "work:runner": "NODE_OPTIONS=--conditions=react-server tsx scripts/work-runner.ts",
    "work:scheduler": "NODE_OPTIONS=--conditions=react-server tsx scripts/work-scheduler.ts",
    "work:repair-prompts": "NODE_OPTIONS=--conditions=react-server tsx scripts/repair-adopted-prompts.ts",
    "work:trigger-poller": "NODE_OPTIONS=--conditions=react-server tsx scripts/work-trigger-poller.ts",
    "research:worker": "NODE_OPTIONS=--conditions=react-server tsx scripts/research-worker.ts",
    "memory:dreamer": "NODE_OPTIONS=--conditions=react-server tsx scripts/memory-dreamer.ts",
    "agents:reflector": "NODE_OPTIONS=--conditions=react-server tsx scripts/agent-reflector.ts",
    "memory:bench": "NODE_OPTIONS=--conditions=react-server tsx scripts/memory-bench.ts",
    "import:recovery": "NODE_OPTIONS=--conditions=react-server tsx scripts/sweep-import-runs.ts",
    "search:check": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-search-providers.ts",
    "validate:models": "tsx scripts/validate-models.ts",
    "providers:check": "tsx scripts/check-provider-keys.ts",
    "gemini:live-auth": "tsx scripts/check-gemini-live-auth.ts",
    "models:capabilities:audit": "tsx scripts/audit-model-capabilities.ts",
    "security:check": "node scripts/security-check.mjs",
    "security:dependencies": "node scripts/dependency-audit.mjs",
    "email:dns:verify": "node --env-file-if-exists=.env scripts/verify-email-dns.mjs --strict",
    "sync:prune": "tsx scripts/prune-sync.ts",
    "models:probe": "NODE_OPTIONS=--conditions=react-server tsx scripts/probe-models.ts",
    "production:smoke": "node scripts/production-smoke.mjs",
    "backup:production": "node scripts/backup-production.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:drill": "node scripts/restore-drill.mjs",
    "eval:juno": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/eval-juno.ts",
    "domain:checks": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/domain-checks.ts",
    "backup:restore": "node scripts/restore-production.mjs",
    "sync:benchmarks": "tsx scripts/fetch-benchmarks.ts",
    "radar:models": "tsx scripts/model-radar.ts",
    "design:contract": "tsx scripts/generate-design-contract.ts",
    "design:contract:check": "tsx scripts/generate-design-contract.ts --check",
    "design:tokens": "tsx scripts/generate-design-tokens.ts",
    "design:tokens:check": "tsx scripts/generate-design-tokens.ts --check",
    "design:editor": "node scripts/build-design-editor.mjs",
    "design:editor:check": "node scripts/build-design-editor.mjs --check",
    "design:fixture": "tsx scripts/emit-design-fixture.ts"
  },
