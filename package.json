    "native:consumption:test": "JUNO_SWIFT_FILTER='JunoDesignSystemTests\\.(JunoTokenConsumptionTests|JunoColorConsumptionTests|JunoTypeLadderTests|JunoBrandTests)' bash scripts/native-test.sh JunoNativeKit",
