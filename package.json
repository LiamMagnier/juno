    "native:wire:check": "tsx scripts/generate-chat-wire-contract.ts --check",
    "native:parity": "node scripts/parity-ledger.mjs",
    "native:parity:check": "node scripts/parity-ledger.mjs --check",
    "native:register:check": "node scripts/check-design-register.mjs",
