    "agent:protocol:check": "node scripts/generate-agent-protocol.mjs --check && tsx scripts/fold-agent-fixtures.ts --check",
    "code-v2:contracts": "node scripts/check-code-v2-contracts.mjs --write",
    "code-v2:contracts:check": "node scripts/check-code-v2-contracts.mjs",
