// ----------------------------------------------------------------------------
// Per-request API cost ledger. One row per billable model call; monthly sums
// drive the plan budget gauge. Never decremented when content is deleted.
// ----------------------------------------------------------------------------

model ApiSpend {
  id               String   @id @default(cuid())
  userId           String
  model            String
  kind             String   @default("chat") // chat | image | video | voice | code
  source           String   @default("web") // web | app — which surface produced the spend
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costMicroUsd     Int // request cost in micro-USD (1e-6 $) — integer math only
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  // The platform-wide daily total (platform-budget.ts) filters on createdAt with
  // no userId, and Postgres cannot range-scan a composite index whose leading
  // column is absent from the predicate — so that query would seq-scan the
  // fastest-growing table in the schema, once a minute per process, before a
  // chat can start streaming.
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Moderation flags — one row per detected CGU/policy violation (automatic AI
// moderation or a manual admin note). Soft violations add a strike; severe ones
// ban immediately. Kept for the admin audit trail and appeals.
