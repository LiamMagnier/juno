# The computer host's TLS front (generated by setup.sh --print-nginx, which fills in the
# listen lines, the domain, the certificate and key, the two logs and the two loopback
# ports; local/run-local.sh --nginx serves the same file in the official nginx image).
#
# No request path or query in either log: users' file paths travel in ?path= (the same
# path-free format as deploy/exec-host/setup.sh). The error log is at `crit`, because nginx
# writes the whole request line into every `error` entry (an upstream timeout, a closed
# client), and the host service logs its own failures without paths.
log_format juno_computer_host '$remote_addr [$time_local] $request_method $status $body_bytes_sent $request_time';

server {
@LISTEN@
    server_name @DOMAIN@;
    ssl_certificate @CERT@;
    ssl_certificate_key @KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 30m;
    access_log @ACCESS_LOG@ juno_computer_host;
    error_log @ERROR_LOG@ crit;
    server_tokens off;

    # CDP and VNC tunnels. Both legs ping every 30 s, so a quiet tunnel never
    # idles past these; how long a tunnel lives is bounded by the relay (2 h for
    # VNC) and by the run (CDP).
    location = /v1/tunnel {
        proxy_pass http://@TUNNEL@;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # A command may run 300 s, plus 5 s to kill it, plus margin; its output may
    # be streamed (NDJSON), so nothing is buffered either way.
    location ~ ^/v1/computers/[^/]+/exec$ {
        proxy_pass http://@API@;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 330s;
        proxy_send_timeout 330s;
    }

    location / {
        proxy_pass http://@API@;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
