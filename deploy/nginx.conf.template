# ── "Updating, back in a moment" ────────────────────────────────────────────
#
# While a deploy restarts the app, nginx cannot reach it and answers 502. A
# person loading a page used to get nginx's bare error page and had to guess
# when to reload. Page navigations now get a small static page that says what
# is happening and reloads itself every few seconds
# (deploy/maintenance/updating.html), served with 503 and Retry-After.
#
# Only for errors nginx itself produced (proxy_intercept_errors stays off, so
# a page or route the app answered with an error is passed through as the app
# wrote it), and only for page navigations: /api/* keeps exactly what it had
# (its own location below, with no error page), and a non-navigation request
# under / (an RSC fetch, an image) gets the plain 502 it always got.
#
# Install the page once on the VM, from the checkout of this repository:
#   sudo install -D -m 644 deploy/maintenance/updating.html /var/www/juno-maintenance/updating.html
# Without it nginx falls back to its plain 502, exactly as before.
#
# A navigation: a browser's Sec-Fetch-Mode says so; an older one without
# Sec-Fetch headers asks for HTML. A Next.js client-side transition carries
# `RSC: 1` and is never one.
map "$request_method:$http_sec_fetch_mode:$http_rsc:$http_accept" $juno_page_navigation {
    default                          0;
    "~^(GET|HEAD):navigate::"        1;
    "~^(GET|HEAD):::[^:]*text/html"  1;
}

# Where `location /` sends an error nginx produced (its error_page below).
map $juno_page_navigation $juno_unavailable {
    1        /__juno_updating;
    default  @juno_bad_gateway;
}

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN; # Replace with api.yourdomain.com or your domain
    server_tokens off;

    # Redirect all HTTP requests to HTTPS (Certbot will overwrite this, but it's a good default)
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN; # Replace with api.yourdomain.com or your domain
    server_tokens off;

    # SSL configuration (to be populated by Let's Encrypt / Certbot automatically)
    # ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    # Logs
    access_log /var/log/nginx/juno_backend_access.log;
    error_log /var/log/nginx/juno_backend_error.log;

    # Announcement media uploads (images/videos) go through /api/admin/
    # announcements/upload with an app-level 100 MB cap — nginx's 1 MB default
    # client_max_body_size would 413 them before Next.js ever runs.
    client_max_body_size 120m;

    # Default large_client_header_buffers (8 × 8k) rejects long request lines /
    # cookies with 414 Request-URI Too Large. Bump so large chats never die at
    # the proxy (prompt text itself goes in the POST body, not the URI).
    client_header_buffer_size 32k;
    large_client_header_buffers 8 64k;

    # Voice relay WebSocket (standalone service on :8787). Clients connect to
    # wss://YOUR_DOMAIN/voice-relay — the relay ignores the request path on
    # upgrade and serves /healthz at any path suffix, so the URI passes
    # through untouched (no proxy_pass URI part = no prefix rewriting).
    location /voice-relay {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;

        # Voice sessions are long-lived (up to 120 min per provider caps);
        # audio frames flow continuously, but keep a generous idle ceiling.
        proxy_buffering off;
        proxy_read_timeout 7200s;
        proxy_send_timeout 7200s;
    }

    # Build output: hashed filenames, so Next serves them `immutable` and a
    # browser asks for each one exactly once. They are still worth their own
    # location, because `location /` below turns proxy buffering OFF for the
    # sake of SSE — and that setting applied to these too.
    #
    # Unbuffered, nginx relays a response in whatever slices it reads from the
    # upstream socket, and cannot release that upstream connection until the
    # slowest client has taken the last byte. A page here loads ~36 of these
    # chunks, so a first visit on a slow link held ~36 Node connections open
    # for its whole duration, on the single-process server that was also trying
    # to render pages. Buffered, nginx takes each file from Next at local
    # speed, frees the connection, and feeds the client on its own time.
    #
    # Next already gzips these and stamps `Cache-Control: immutable`, so there
    # is nothing to add on either count — this is only about who does the
    # waiting.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;

        proxy_buffering on;
        # 256 KB of buffer per response: the largest chunk this app emits is
        # ~330 KB raw / ~94 KB gzipped, so the common case is absorbed in one
        # pass rather than spilling to a temp file.
        proxy_buffers 32 8k;
        proxy_buffer_size 16k;
        proxy_busy_buffers_size 32k;
    }

    # The API: the same proxying as `location /` below, directive for
    # directive, and deliberately no error page. A client of /api/* (the web
    # app's fetches, the Mac and iPhone apps) reads the app's JSON errors and
    # must never be handed an HTML page in their place; while the app is down
    # it gets nginx's plain 502, as it always did, and the clients retry what
    # is safe to retry (src/lib/chat/send-retry.ts). Keep the two blocks in
    # step: tests/deploy-maintenance-page.test.ts compares them.
    #
    # Side effect of the trailing slash: a request for exactly `/api` gets
    # nginx's automatic 301 to `/api/` instead of reaching the app. Nothing
    # calls it, and the app has no route there (src/app/api has no route.ts).
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_hide_header X-Powered-By;

        proxy_request_buffering off;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding on;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Headers for WebSockets and streaming
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_hide_header X-Powered-By;

        # Large uploads stream straight to Next instead of buffering to
        # nginx temp files first.
        proxy_request_buffering off;

        # Streaming settings for LLM reasoning responses (Server-Sent Events).
        # proxy_read_timeout is the ceiling between reads from the app; on a
        # self-hosted box THIS replaces Vercel's 300s maxDuration wall. The chat
        # route sends a ping every 15s (see route.ts heartbeat), which resets this
        # timer, so the connection survives long silent "thinking" gaps regardless.
        # 3600s (1h) is a generous safety margin for max-effort reasoning runs.
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding on;

        # The app is not answering (a deploy restarting it): a page navigation
        # gets the "Updating, back in a moment" page, anything else the plain
        # 502 (see the top of this file).
        error_page 502 503 504 =503 $juno_unavailable;
    }

    # The page, for page navigations only, with 503 and Retry-After.
    location = /__juno_updating {
        internal;
        root /var/www/juno-maintenance;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "8" always;
        add_header X-Robots-Tag "noindex" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        # The page not installed: the plain 502, exactly as before.
        try_files /updating.html @juno_bad_gateway;
    }

    # nginx's plain 502, headers and all, exactly as before this page existed.
    location @juno_bad_gateway {
        return 502;
    }
}

# ── Artifact preview origin (optional) ──────────────────────────────────────
#
# Only when NEXT_PUBLIC_SANDBOX_ORIGIN is set (see .env.example). A separate host
# for the artifact preview shell, so previews never share an origin — or the
# host-only session cookie — with the app. Uncomment, replace PREVIEW_DOMAIN,
# issue a certificate for it (certbot --nginx -d PREVIEW_DOMAIN), and rebuild the
# app with NEXT_PUBLIC_SANDBOX_ORIGIN="https://PREVIEW_DOMAIN". Prefer a different
# registrable domain from the app's (e.g. juno-preview.net rather than
# preview.juno.app) if one is available: a sibling subdomain still counts as the
# same site. The app refuses every other path on this host itself
# (documentPolicyFor in src/lib/sandbox-policy.ts); nginx refusing them too keeps
# them off the app entirely.
