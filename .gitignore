# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# env
.env
.env*.local
.env.production

# prisma
/prisma/migrations/dev.db*

# local dev file storage (S3 fallback)
/.uploads

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo

# Neon CLI local state
.neon
.env*
!.env.example

# voice relay service
relay/node_modules
relay/dist

# Agent worktrees and local Claude state
.claude/
.worktrees/

# vendored agent core for the Cloud Code runner (built in CI)
runner/agent-core/node_modules
runner/agent-core/dist

# Release artifacts: the build products themselves are large binaries and are
# reproducible from a tagged commit. The delivery documentation and the current
# SHA256SUMS.txt in dist/ are tracked; the binaries and the per-commit checksum
# snapshots are not.
dist/*.app/
dist/*.dmg
dist/*.ipa
dist/*.zip
dist/SHA256SUMS-*.txt

# Desktop/mobile release binaries are served from GitHub Releases (see
# /api/downloads), never from the repo. A 22 MB .dmg in public/ ships to every
# clone and every deploy rsync for no reason.
/public/downloads/*.dmg
/public/downloads/*.zip
/public/downloads/*.pkg
native/Config/Generated-Build.xcconfig

# native build artifacts
native/**/*.xcodeproj/xcuserdata/
native/**/*.xcodeproj/project.xcworkspace/xcuserdata/
native/**/*.xcodeproj/-Xcc/
native/**/.build/
DerivedData/
*.xcresult

# Generated at predev/prebuild by scripts/generate-i18n-catalog.mjs from the
# source tree itself, byte-reproducibly. Tracking it meant every `npm run dev`
# dirtied the working tree with a 195 KB diff.
# NOTE: src/lib/models.generated.ts and src/lib/benchmarks.generated.ts are
# deliberately NOT ignored — those are curated registry state committed by the
# nightly sync-models workflow and are not reproducible without provider keys.
/src/lib/i18n-catalog.generated.ts
