# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# env
.env
.env*.local
.env.production

# prisma
/prisma/migrations/dev.db*

# local dev file storage (S3 fallback)
/.uploads

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo

# Neon CLI local state
.neon
.env*
!.env.example

# voice relay service
relay/node_modules
relay/dist

# Agent worktrees and local Claude state
.claude/
.worktrees/

# vendored agent core for the Cloud Code runner (built in CI)
runner/agent-core/node_modules
runner/agent-core/dist

# Juno Desktop (Electron). Self-contained sub-workspace with its own lockfile,
# built in CI. `out/` is electron-vite's bundle output; `dist/` is the packaged
# .app/.dmg. The generated design tokens under src/renderer/styles ARE tracked,
# because the drift gate byte-compares them.
native/desktop-electron/node_modules
native/desktop-electron/out
native/desktop-electron/dist
native/desktop-electron/coverage
native/desktop-electron/test-results
native/desktop-electron/playwright-report

# Release artifacts: the build products themselves are large binaries and are
# reproducible from a tagged commit. The delivery documentation and the current
# SHA256SUMS.txt in dist/ are tracked; the binaries and the per-commit checksum
# snapshots are not.
dist/*.app/
dist/*.dmg
dist/*.ipa
dist/*.zip
dist/SHA256SUMS-*.txt

# Desktop/mobile release binaries are served from GitHub Releases (see
# /api/downloads), never from the repo. A 22 MB .dmg in public/ ships to every
# clone and every deploy rsync for no reason.
/public/downloads/*.dmg
/public/downloads/*.zip
/public/downloads/*.pkg
native/Config/Generated-Build.xcconfig

# native build artifacts
native/**/*.xcodeproj/xcuserdata/
native/**/*.xcodeproj/project.xcworkspace/xcuserdata/
native/**/*.xcodeproj/-Xcc/
native/**/.build/
# A SwiftPM scratch directory at the repo ROOT, which the pattern above does not
# match. `swift build` run from the checkout root rather than with
# --package-path puts one here, and it is only ever two files (CACHEDIR.TAG and
# a build-system stamp) — small enough to sail past a `git status` skim and get
# committed. Ignored rather than tolerated because nothing should be building
# from here at all; see `npm run native:test` for the command that does not.
/.build/
DerivedData/
*.xcresult

# Generated at predev/prebuild by scripts/generate-i18n-catalog.mjs from the
# source tree itself, byte-reproducibly. Tracking it meant every `npm run dev`
# dirtied the working tree with a 195 KB diff.
# NOTE: src/lib/models.generated.ts and src/lib/benchmarks.generated.ts are
# deliberately NOT ignored — those are curated registry state committed by the
# nightly sync-models workflow and are not reproducible without provider keys.
/src/lib/i18n-catalog.generated.ts

# Local SQLite dev database — contains real conversation data, never commit it.
prisma/dev.db
prisma/dev.db-journal

# Local .env snapshots taken before editing — never commit these.
.env.backup-*

# Playwright artifacts and authenticated-session state — regenerated per run.
test-results/
playwright-report/
e2e/.auth/
