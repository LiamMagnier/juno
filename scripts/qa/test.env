# Test-only values for the QA runner (scripts/qa/run-prod-e2e.sh).
#
# Every value here is fake and exists only so a production build can boot
# against the disposable *_test database. None is a real key, and none may
# ever become one: the runner passes these to `next build`, `next start`,
# the seed scripts and Playwright, and nothing else from the parent
# environment reaches them (spec §14, P0 (2)).
#
# The runner owns PATH, HOME, TMPDIR, CI, NODE_ENV, PORT, DATABASE_URL,
# DIRECT_URL, JUNO_E2E_SMOKE_PROVIDER and its own ALEVR_QA_* variables;
# safe-env.mjs refuses this file if it tries to set any of them.

# Session signing for the seeded E2E account.
AUTH_SECRET=alevr-qa-test-only-auth-secret-not-a-real-key
# NextAuth must trust the random 127.0.0.1 port the runner picks.
AUTH_TRUST_HOST=true

# Production refuses to boot without explicit at-rest keys (src/lib/boot.ts).
# Base64 of the ASCII strings "alevr-qa-test-only-data-key-0001" and
# "alevr-qa-test-only-token-key-001": 32 bytes each, obviously not secret.
DATA_ENCRYPTION_KEYRING=qa:YWxldnItcWEtdGVzdC1vbmx5LWRhdGEta2V5LTAwMDE=
DATA_ENCRYPTION_ACTIVE_KEY_ID=qa
TOKEN_ENCRYPTION_KEYS=qa:YWxldnItcWEtdGVzdC1vbmx5LXRva2VuLWtleS0wMDE=
TOKEN_ENCRYPTION_PRIMARY=qa

# The account scripts/seed-e2e-user.ts creates in the test database.
E2E_EMAIL=e2e@juno.test
E2E_PASSWORD=E2E-Test-Password-2026!

# No phone-home from the build or the Prisma CLI during QA runs.
NEXT_TELEMETRY_DISABLED=1
CHECKPOINT_DISABLE=1
