{
  "comment": "Routes for scripts/design-audit/geometry-audit.mjs. Menus, submenus, popovers and dialogs are opened by small `open` scripts so their geometry is measured too. auth:false routes use a signed-out context; /dev galleries render real components without sign-in. Steps (and routes) marked when: phone or desktop run only at that width: a phone opens the sidebar drawer where a desktop hovers. Pages that need a specific record (a long answer, an agent thread, a project, a /share link) reach the first one by clicking; a run against seeded data can pin them by id in its own routes file.",
  "routes": [
    {"name": "chat · home", "path": "/chat", "waitFor": "[contenteditable=true], textarea"},
    {"name": "chat · model menu", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{"click": "button[aria-label^='Model:']"}, {"waitFor": "[role=menu], [role=dialog], [role=listbox]"}]},
    {"name": "chat · account menu", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{"click": "button[aria-label='Open menu']", "when": "phone"}, {"wait": 600, "when": "phone"}, {"click": "button[aria-label*=' plan']"}, {"waitFor": "[role=menu]"}]},
    {"name": "chat · row menu", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{"click": "button[aria-label='Open menu']", "when": "phone"}, {"wait": 600, "when": "phone"}, {"hover": "[data-conversation-row] [data-row-link]", "when": "desktop"}, { "click": "[data-conversation-row] button[aria-label='Conversation options']", "force": true, "when": "desktop" }, { "click": "[data-conversation-row] button[aria-label='Conversation options']", "when": "phone" }, {"waitFor": "[role=menu]"}]},
    {"name": "chat · row submenu", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{"click": "button[aria-label='Open menu']", "when": "phone"}, {"wait": 600, "when": "phone"}, {"hover": "[data-conversation-row] [data-row-link]", "when": "desktop"}, { "click": "[data-conversation-row] button[aria-label='Conversation options']", "force": true, "when": "desktop" }, { "click": "[data-conversation-row] button[aria-label='Conversation options']", "when": "phone" }, {"waitFor": "[role=menu]"}, {"hover": "[role=menu] [aria-haspopup=menu]", "when": "desktop"}, {"click": "[role=menu] [aria-haspopup=menu]", "when": "phone"}, {"waitFor": "[role=menu] >> nth=1"}]},
    {"name": "chat · notifications", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{"click": "button[aria-label='Open menu']", "when": "phone"}, {"wait": 600, "when": "phone"}, {"click": "button[aria-label^='Notifications']"}, {"waitFor": "[role=dialog], [data-radix-popper-content-wrapper]"}]},
    {"name": "chat · command palette", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{"click": "button[aria-label='Open menu']", "when": "phone"}, {"wait": 600, "when": "phone"}, {"click": "button:has-text('Search')", "when": "phone"}, {"press": "Control+k", "when": "desktop"}, {"waitFor": "[role=dialog] input, [cmdk-input]"}]},
    {"name": "chat · shortcuts dialog", "path": "/chat", "when": "desktop", "waitFor": "[contenteditable=true], textarea", "open": [{"click": "button[aria-label*=' plan']"}, {"waitFor": "[role=menu]"}, {"click": "[role=menuitem]:has-text('Keyboard shortcuts')"}, {"waitFor": "[role=dialog]"}, {"wait": 300}]},
    {"name": "conversation · add menu", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{"click": "button[aria-label='Open menu']", "when": "phone"}, {"wait": 600, "when": "phone"}, {"click": "[data-conversation-row] [data-row-link]"}, {"waitForUrl": "/chat/[^/?#]+"}, {"waitFor": "[data-message-id]"}, {"click": "button.composer-plus"}, {"waitFor": "[role=menu]"}]},
    {"name": "conversation · add submenu", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{"click": "button[aria-label='Open menu']", "when": "phone"}, {"wait": 600, "when": "phone"}, {"click": "[data-conversation-row] [data-row-link]"}, {"waitForUrl": "/chat/[^/?#]+"}, {"waitFor": "[data-message-id]"}, {"click": "button.composer-plus"}, {"waitFor": "[role=menu]"}, {"hover": "[role=menu] [aria-haspopup=menu]", "when": "desktop"}, {"waitFor": "[role=menu] >> nth=1", "when": "desktop"}, {"click": "[role=menu] [data-panel-id]", "when": "phone"}, {"waitFor": "[data-menu-back]", "when": "phone"}, {"wait": 300}]},
    {"name": "conversation · longest answer", "path": "/chat", "scope": "page", "waitFor": "[contenteditable=true], textarea", "open": [{"click": "button[aria-label='Open menu']", "when": "phone"}, {"wait": 600, "when": "phone"}, {"click": "[data-conversation-row] [data-row-link]"}, {"waitForUrl": "/chat/[^/?#]+"}, {"waitFor": "[data-message-id]"}, {"eval": "(() => { const els = [...document.querySelectorAll('[data-message-id]')]; const el = els.reduce((a, b) => (!a || b.textContent.length > a.textContent.length ? b : a), null); if (el) el.scrollIntoView({ block: 'start' }); return !!el; })()"}, {"wait": 500}]},
    {"name": "research", "path": "/research", "waitFor": "[contenteditable=true], textarea"},
    {"name": "agents · first agent", "path": "/agents", "open": [{"click": "main a[href^='/agents/']"}, {"waitForUrl": "/chat/[^/?#]+"}, {"waitFor": "[contenteditable=true], textarea"}], "scope": "page"},
    {"path": "/projects"},
    {"name": "projects · new project dialog", "path": "/projects", "open": [{ "eval": "(() => { const b = [...document.querySelectorAll('main button')].find((e) => /New project/.test(e.textContent || '') && e.getBoundingClientRect().width > 0); if (b) b.click(); return !!b; })()" }, {"waitFor": "[role=dialog]"}, {"wait": 300}]},
    {"name": "project · first", "path": "/projects", "scope": "page", "open": [{"click": "main a[href^='/projects/']"}, {"waitForUrl": "/projects/[^/?#]+"}, {"wait": 800}]},
    {"path": "/library"},
    {"path": "/artifacts"},
    {"path": "/agents"},
    {"path": "/code"},
    {"name": "customize · apps", "path": "/customize"},
    {"name": "customize · skills", "path": "/skills"},
    {"name": "customize · routines", "path": "/automations"},
    {"name": "customize · memory", "path": "/memory"},
    {"name": "customize · instructions", "path": "/customize/instructions"},
    {"path": "/connections"},
    {"name": "settings · general", "path": "/settings"},
    {"name": "settings · personalization", "path": "/settings?section=personalization"},
    {"name": "settings · models", "path": "/settings?section=models"},
    {"name": "settings · data", "path": "/settings?section=data"},
    {"path": "/activity"},
    {"path": "/upgrade"},
    {"path": "/profile"},
    {"path": "/tasks"},
    {"path": "/compare"},
    {"path": "/design"},
    {"name": "landing", "path": "/", "auth": false},
    {"name": "sign-in", "path": "/sign-in", "auth": false},
    {"name": "sign-up", "path": "/sign-up", "auth": false},
    {"name": "download", "path": "/download", "auth": false},
    {"name": "legal · cgu", "path": "/legal/cgu", "auth": false},
    {"path": "/dev/controls", "auth": false, "allowError": true},
    {"path": "/dev/shell", "auth": false, "allowError": true},
    {"path": "/dev/model-picker", "auth": false, "allowError": true, "open": [{"click": "[data-testid=chip-host] button"}, {"waitFor": "[data-radix-popper-content-wrapper], [role=dialog], [role=listbox], [role=menu]"}]},
    {"path": "/dev/thread", "auth": false, "allowError": true},
    {"path": "/dev/transcript", "auth": false, "allowError": true},
    {"path": "/dev/settings", "auth": false, "allowError": true},
    {"path": "/dev/composer-chip", "auth": false, "allowError": true},
    {"path": "/dev/sources", "auth": false, "allowError": true},
    {"path": "/dev/memory", "auth": false, "allowError": true},
    {"path": "/dev/permissions", "auth": false, "allowError": true}
  ]
}
