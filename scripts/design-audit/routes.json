{
  "comment": "Routes for scripts/design-audit/geometry-audit.mjs. Menus, submenus, popovers and dialogs are opened by small `open` scripts so their geometry is measured too. auth:false routes use a signed-out context; /dev galleries render real components without sign-in.",
  "routes": [
    { "name": "chat · home", "path": "/chat", "waitFor": "[contenteditable=true], textarea" },
    { "name": "chat · conversation", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{ "click": "a[href^='/chat/']" }, { "waitForHidden": "[data-loading-thread]", "optional": true }, { "wait": 1500 }] },
    { "name": "chat · model menu", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{ "click": "button[aria-label^='Model:']" }, { "waitFor": "[role=menu], [role=dialog], [role=listbox]" }] },
    { "name": "chat · add menu", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{ "click": "button[aria-label='Add']" }, { "waitFor": "[role=menu]" }] },
    { "name": "chat · add submenu", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{ "click": "button[aria-label='Add']" }, { "waitFor": "[role=menu]" }, { "hover": "[role=menu] [aria-haspopup=menu]" }, { "waitFor": "[role=menu] >> nth=1" }] },
    { "name": "chat · account menu", "path": "/chat", "open": [{ "click": "button[aria-label*=' plan']" }, { "waitFor": "[role=menu]" }] },
    { "name": "chat · conversation options", "path": "/chat", "open": [{ "hover": "a[href^='/chat/']" }, { "click": "button[aria-label='Conversation options']", "force": true }, { "waitFor": "[role=menu]" }] },
    { "name": "chat · conversation options submenu", "path": "/chat", "open": [{ "hover": "a[href^='/chat/']" }, { "click": "button[aria-label='Conversation options']", "force": true }, { "waitFor": "[role=menu]" }, { "hover": "[role=menu] [aria-haspopup=menu]" }, { "waitFor": "[role=menu] >> nth=1" }] },
    { "name": "chat · notifications", "path": "/chat", "open": [{ "click": "button[aria-label^='Notifications']" }, { "waitFor": "[role=dialog], [data-radix-popper-content-wrapper]" }] },
    { "name": "chat · command palette", "path": "/chat", "waitFor": "[contenteditable=true], textarea", "open": [{ "press": "Control+k" }, { "waitFor": "[role=dialog]" }] },
    { "name": "chat · download menu", "path": "/chat", "open": [{ "click": "button[aria-label='Download the app']" }, { "waitFor": "[role=menu], [role=dialog]" }] },
    { "path": "/projects" },
    { "path": "/library" },
    { "path": "/artifacts" },
    { "path": "/agents" },
    { "path": "/automations" },
    { "path": "/tasks" },
    { "path": "/code" },
    { "path": "/research" },
    { "path": "/compare" },
    { "path": "/design" },
    { "path": "/memory" },
    { "path": "/skills" },
    { "path": "/connections" },
    { "path": "/customize" },
    { "path": "/profile" },
    { "path": "/settings" },
    { "path": "/activity" },
    { "path": "/upgrade" },
    { "name": "sign-in", "path": "/sign-in", "auth": false },
    { "name": "sign-up", "path": "/sign-up", "auth": false },
    { "path": "/dev/controls", "auth": false },
    { "path": "/dev/shell", "auth": false },
    { "path": "/dev/model-picker", "auth": false },
    { "path": "/dev/thread", "auth": false },
    { "path": "/dev/transcript", "auth": false },
    { "path": "/dev/settings", "auth": false },
    { "path": "/dev/composer-chip", "auth": false },
    { "path": "/dev/sources", "auth": false },
    { "path": "/dev/memory", "auth": false },
    { "path": "/dev/permissions", "auth": false },
    { "name": "phone · chat home", "path": "/chat", "viewport": "390x844", "waitFor": "[contenteditable=true], textarea" },
    { "name": "phone · add menu", "path": "/chat", "viewport": "390x844", "waitFor": "[contenteditable=true], textarea", "open": [{ "click": "button[aria-label='Add']" }, { "waitFor": "[role=menu], [role=dialog]" }] },
    { "name": "phone · settings", "path": "/settings", "viewport": "390x844" }
  ]
}
